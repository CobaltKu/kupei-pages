    "/api/store": {
      "get": {
        "summary": "雲端文件列表（需登入或寫入權杖）",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "docs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DocMeta"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/StoreRateLimited"
          }
        },
        "description": "用登入權杖時文件屬於該帳號（owner u:<id>），別的帳號與寫入權杖都看不到；寫入權杖共用 owner kupei"
      }
    },
    "/api/store/{key}": {
      "get": {
        "summary": "讀一份雲端文件（需登入或寫入權杖）",
        "parameters": [
          {
            "$ref": "#/components/parameters/DocKey"
          }
        ],
        "responses": {
          "200": {
            "description": "OK；沒有時 version 0、data null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Doc"
                }
              }
            }
          },
          "400": {
            "description": "key 格式不對",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/StoreRateLimited"
          }
        },
        "description": "用登入權杖時文件屬於該帳號（owner u:<id>），別的帳號與寫入權杖都看不到；寫入權杖共用 owner kupei"
      },
      "put": {
        "summary": "整包寫入（樂觀鎖）",
        "parameters": [
          {
            "$ref": "#/components/parameters/DocKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutDoc"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已寫入",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "updatedAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "內容或 key 不對",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "權杖不能用雲端文件（FORBIDDEN），或超過每個 owner 的上限：50 份、合計 2 MB（QUOTA_EXCEEDED，details 為 { docs, bytes, maxDocs, maxBytes }）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "description": "data 超過 256 KB，或請求本文超過 300 KB（先看 Content-Length）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/StoreRateLimited"
          }
        },
        "description": "用登入權杖時文件屬於該帳號（owner u:<id>），別的帳號與寫入權杖都看不到；寫入權杖共用 owner kupei"
      },
      "delete": {
        "summary": "刪除（版本相符才刪）",
        "parameters": [
          {
            "$ref": "#/components/parameters/DocKey"
          },
          {
            "name": "baseVersion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "已刪除",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "baseVersion 缺少或不是 ≥ 1 的整數，或 key 格式不對",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "沒有這份文件",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/StoreRateLimited"
          }
        },
        "description": "用登入權杖時文件屬於該帳號（owner u:<id>），別的帳號與寫入權杖都看不到；寫入權杖共用 owner kupei"
      }
    },
