    "/api/auth/password": {
      "post": {
        "summary": "改密碼",
        "description": "需要 Authorization: Bearer <登入權杖>。成功後這個帳號所有登入權杖都失效（含這台的舊權杖），回傳給這台的新權杖（格式同 login）。新的雜湊用現行的 PBKDF2 次數重算",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已改密碼，回傳新的登入權杖",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST：格式不對（新密碼要 8～128 字）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS：目前密碼不對（登入權杖不受影響）；UNAUTHENTICATED：登入權杖無效或過期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/AuthRateLimited"
          }
        }
      }
    },
